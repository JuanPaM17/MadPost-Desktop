{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MadPost Desktop",
  "version": "1.10.0",
  "identifier": "com.madpost.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MadPost Desktop",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2Q0VGNEI1NEZGQTgyM0QKUldROWd2cFB0ZlRPSnNlbXBTR21NOHo5djRwNWwyYjlVUGJBM2NmN0lGU2EvaCtkYWNHOWt5VWMK",
      "endpoints": [
        "https://raw.githubusercontent.com/JuanPaM17/MadPost-Desktop/releases-manifest/stable-latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
